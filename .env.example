# PayPal REST app credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Where the SQLite file lives. Deleted and recreated by `python -m backstop.seed`.
BACKSTOP_DB=backstop.db

# Chaos mode. When "refund", the PayPal call is really sent and then the
# response is thrown away, which is what a lost response looks like to us.
# This is how the demo proves a retry cannot double-refund.
BACKSTOP_CHAOS=

# Anthropic key for the agent. Not needed for the backstop itself or the tests.
ANTHROPIC_API_KEY=
